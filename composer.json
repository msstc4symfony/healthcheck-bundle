{
  "name": "msstc4symfony/healthcheck-bundle",
  "license": "MIT",
  "authors": [
    {
      "name": "Maxim Shamaev",
      "email": "maxim.shamaev@gmail.com"
    }
  ],
  "type": "symfony-bundle",
  "description": "Health checks bundle",
  "minimum-stability": "stable",
  "keywords": ["php", "symfony", "healthcheck"],
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Msstc4Symfony\\HealthCheckBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Msstc4Symfony\\HealthCheckBundle\\Test\\Integration\\": "tests/integration/",
      "Msstc4Symfony\\HealthCheckBundle\\Test\\Mock\\": "tests/mock/",
      "Msstc4Symfony\\HealthCheckBundle\\Test\\Unit\\": "tests/unit/"
    }
  },
  "require": {
    "php": ">=8.4",
    "composer-runtime-api": ">=2.2",
    "psr/log": "^3.0",
    "symfony/framework-bundle": "^6.4|^7.0|^8.0",
    "symfony/http-foundation": "^6.4|^7.0|^8.0",
    "symfony/console": "^6.4|^7.0|^8.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.55",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-beberlei-assert": "^2.0",
    "phpstan/phpstan-doctrine": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": ">=10.5",
    "roave/security-advisories": "dev-latest",
    "rector/rector": "^2.1",
    "spaze/phpstan-disallowed-calls": "^v4.0"
  },
  "suggest": {
    "symfony/monolog-bundle": "To upload the verification results to the logs"
  },
  "config": {
    "allow-plugins": {
      "composer/package-versions-deprecated": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "^6.4|^7.0|^8.0"
    }
  },
  "scripts": {
    "healthcheck:readiness": "./bin/console healthcheck:readiness",
    "healthcheck:liveliness": "./bin/console healthcheck:liveliness"
  }
}
